# Supabase Postgres — Transaction pooler (port 6543) for app runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Auth signing secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=""
# Key for encrypting stored secrets at rest (e.g. client website passwords).
# Optional — falls back to JWT_SECRET if unset. Generate the same way as JWT_SECRET.
ENCRYPTION_KEY=""
# Anthropic API key for the Claude LLM gateway
ANTHROPIC_API_KEY=""
NODE_ENV=development

# DataForSEO API credentials (dashboard → API Access)
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
# Optional: Google PageSpeed Insights API key for Core Web Vitals
PAGESPEED_API_KEY=""

# Gemini API key for AI image generation
GEMINI_API_KEY=""
# Supabase Storage (server-side uploads use the service_role key)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="content-images"

# Social posting (Ayrshare) + newsletter (Resend)
ZERNIO_API_KEY=""
RESEND_API_KEY=""
NEWSLETTER_FROM="onboarding@resend.dev"

# Extra AI-visibility engines (Claude via ANTHROPIC_API_KEY + Gemini already configured)
OPENAI_API_KEY=""
PERPLEXITY_API_KEY=""
